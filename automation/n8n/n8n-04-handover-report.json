      "parameters": {
        "jsCode": "const body=$json.body??{};\nconst target_email=typeof body.target_email==='string'?body.target_email.trim().toLowerCase():'';\nconst visitor_email=typeof body.visitor_email==='string'?body.visitor_email.trim().toLowerCase():'';\nconst operation_id=typeof body.operation_id==='string'?body.operation_id:'';\nconst allowed=[\"john.carter@demo-corp.com\",\"sarah.connor@demo-corp.com\",\"tchalla.udaku@demo-corp.com\",\"ellen.ripley@demo-corp.com\",\"arthur.dent@demo-corp.com\",\"marty.mcfly@demo-corp.com\",\"dana.scully@demo-corp.com\"];\nconst valid=typeof body.visitor_email==='string'&&!/[\\r\\n]/.test(body.visitor_email)&&/^[1-9][0-9]{0,17}$/.test(operation_id)&&allowed.includes(target_email)&&visitor_email.length<=254&&/^[^\\s@,;<>:\"\\\\]+@[^\\s@,;<>:\"\\\\]+\\.[^\\s@,;<>:\"\\\\]+$/.test(visitor_email);\nreturn [{json:{valid,operation_id,target_email,visitor_email,owner:$execution.id}}];"
