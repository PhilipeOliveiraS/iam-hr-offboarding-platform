    {
      "parameters": {
        "jsCode": "const candidate = $json.candidates?.[0];\nconst parts = candidate?.content?.parts;\nconst content = Array.isArray(parts) ? parts.filter(p => p.thought !== true && typeof p.text === 'string').map(p => p.text).join('\\n').trim() : '';\nconst valid = Boolean(content) && candidate?.finishReason === 'STOP' && !$json.promptFeedback?.blockReason;\nreturn [{json:{valid, content: valid ? content : '', finish_reason:candidate?.finishReason ?? null}}];"
      },
